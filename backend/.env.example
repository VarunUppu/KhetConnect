# File: backend/.env.example
APP_NAME=KhetConnect
APP_ENV=development

# Must match the credentials in docker-compose.yml
DATABASE_URL=postgresql+psycopg2://khet:khet@localhost:5432/khetconnect

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# console = print the OTP in the server log. Real gateways are registered in services/sms_service.py
SMS_PROVIDER=console